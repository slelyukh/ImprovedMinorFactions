<?xml version="1.0" encoding="utf-8"?>
<!--
  One row per minor faction, copy this and change what you need:

  <MFData id="my_clan_native" minor_faction="Faction.my_clan" module="Native" hideouts="2" num_active_hideouts="1" scenes="bandit_forest,mountain_hideout_002" clan_gender="Any"/>

  Only id and minor_faction are required, everything else falls back to the defaults:
    id                      any unique name for the row
    minor_faction           Faction.<clan id>
    module                  the row only applies when that module is loaded, a later module wins
    enabled                 false gives the faction no hideouts
    hideouts                how many hideouts the faction gets (default 1 + num_active_hideouts)
    num_active_hideouts     hideouts active at the same time (default 1)
    scenes                  hideout battle scenes, comma separated, base game scenes only
    num_militia_first_time  militia in a camp at game start (default 28)
    num_militia_post_raid   militia in a new camp after a raid (default 20)
    num_lvl2_militia        militia one tier above the recruit (default 5)
    num_lvl3_militia        militia two tiers above the recruit (default 3)
    max_militia             militia cap (default 40)
    clan_gender             Male, Female or Any, for the faction's notables (default Any)
    ship                    War Sails ship hull for the faction's parties, for example nord_medium_ship

  Base game hideout scenes: bandit_forest forest_hideout_004 mountain_hideout_001 mountain_hideout_002
  mountain_hideout_004 desert_hideout_002 desert_hideout_004 hideout_steppe_001 hideout_steppe_002
  sea_bandit_a sea_bandit_b sea_bandit_c sea_bandit_d khuzait_village_c (most also have a _sv version)
-->
<MFDatas>

